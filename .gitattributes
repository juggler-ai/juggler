# Ensure consistent line endings across all platforms
* text=auto

# Go files must use LF line endings for gofmt compatibility
*.go text eol=lf

# Shell scripts use LF
*.sh text eol=lf

# Makefiles use LF
Makefile text eol=lf

# Keep Windows batch files with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Generated verbatim copy of the vendored Wails runtime (synced by the Makefile's
# wails-runtime-embed target via cp). Keep it byte-for-byte with its
# 3rdparty/wails source — treat as binary so the `* text=auto` rule above doesn't
# fight the build by trying to normalize the source's original line endings.
cmd/juggler/server/wails_runtime.js -text

# Generated by `make models-sync`; collapsed in diffs. Embedded and compared
# byte-for-byte against the generator's encoding (TestEmbeddedSnapshot), so it
# must stay LF on every checkout — `text=auto` alone gives CRLF on Windows.
cmd/juggler/providers/modelsdev/snapshot.json linguist-generated=true eol=lf
