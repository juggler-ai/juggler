#!/usr/bin/env bash
#
# lint-files — lint a specific set of files with the SAME linters and configs
# that `make lint` uses, scoped to just the paths you pass.
#
# This exists so there is exactly ONE way to lint a subset of the tree. Do NOT
# invoke eslint / stylelint / golangci-lint / gofmt / go vet directly — their
# flags, configs, ignore patterns and tool versions are pinned here and in the
# Makefile so a per-file run matches a full `make lint` run exactly. Reaching
# for the underlying tools by hand reintroduces the drift this wrapper removes.
#
# Usage (prefer the Makefile entrypoint):
#   make lint-files FILES="cmd/juggler/worker/foo.go web/js/bar.js"
#
# Or directly:
#   scripts/lint-files cmd/juggler/worker/foo.go web/js/bar.js web/css/baz.css
#
# Routing is by extension, and each linter sees only the files inside the scope
# the Makefile gives the whole-tree target that runs it:
#   *.go         → gofmt check (outside GO_FOREIGN) + go vet + golangci-lint
#                  (on each file's package, if it is one of GO_PACKAGES)
#   *.js, *.mjs, *.cjs, extensionless
#                → eslint (its config decides which of them it lints), and
#                  lint-css-in-js: stylelint over the CSS they pass to
#                  injectStylesOnce() (it decides which of them it reads)
#   *.css        → stylelint (under CSS_DIRS)
#   *.md         → lint-docs-code (imports in the docs' JavaScript examples)
# A file outside a linter's scope is reported, by name, as skipped by it.
# Other extensions are reported and skipped. Whole-program checks that have no
# meaningful per-file form (deadcode) are intentionally NOT run here — use
# `make lint` for those.
#
# Set FIX=1 (how `make fix-files` invokes this) to auto-fix in place instead of
# reporting: gofmt -w + golangci-lint --fix / eslint --fix / stylelint --fix,
# same routing. Checks with no safe auto-fix (go vet, type errors, deadcode) are
# skipped in fix mode — run `make lint`/`make lint-files` afterwards for those.
#
# Run from the repo root.

set -euo pipefail

# Resolve repo root from this script's location so it works from any cwd.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT"

# The pinned linter version and the lint scopes are the Makefile's, which
# exports them to this script. Run directly, it asks make for them.
for var in GOLANGCI_LINT_VERSION GO_PACKAGES GO_FOREIGN CSS_DIRS; do
	if [ -z "${!var:-}" ]; then
		value="$(make -s --no-print-directory "print-$var")" || {
			echo "lint-files: $var is not set and 'make print-$var' failed — run this through 'make lint-files'." >&2
			exit 2
		}
		if [ -z "$value" ]; then
			echo "lint-files: the Makefile defines no $var." >&2
			exit 2
		fi
		printf -v "$var" '%s' "$value"
	fi
done
NPM_BIN="tooling/node_modules/.bin"
GOPATH_BIN="$(go env GOPATH)/bin"

# Accept files as arguments, or fall back to the $FILES env var (how the
# Makefile target forwards them).
files=("$@")
if [ ${#files[@]} -eq 0 ] && [ -n "${FILES:-}" ]; then
	# shellcheck disable=SC2206
	files=(${FILES})
fi

if [ ${#files[@]} -eq 0 ]; then
	echo "lint-files: no files given." >&2
	echo "Usage: make lint-files FILES=\"path/one.go path/two.js\"" >&2
	exit 2
fi

# Bucket the files by language and scope, and collect unique package dirs for Go.
go_files=()
js_files=()
css_files=()
md_files=()
go_dirs=()
unknown=()
missing=()
skipped=()  # "<linter>: <path>" for each in-language file outside that linter's scope

add_go_dir() {
	local d="$1"
	local existing
	for existing in "${go_dirs[@]:-}"; do
		[ "$existing" = "$d" ] && return 0
	done
	go_dirs+=("$d")
}

# under <path> <dir>... — whether path lies inside one of the dirs.
under() {
	local p="$1" d
	shift
	for d in "$@"; do
		case "$p" in "$d"/*) return 0 ;; esac
	done
	return 1
}

# shellcheck disable=SC2206
foreign_dirs=(${GO_FOREIGN})
# shellcheck disable=SC2206
css_dirs=(${CSS_DIRS})

for f in "${files[@]}"; do
	if [ ! -e "$f" ]; then
		missing+=("$f")
		continue
	fi
	f="${f#./}"
	case "$f" in
		*.go)
			if under "$f" "${foreign_dirs[@]}"; then
				skipped+=("gofmt, go vet, golangci-lint: $f")
				continue
			fi
			go_files+=("$f")
			d="$(dirname "$f")"
			[ "$d" = . ] || d="./$d"
			add_go_dir "$d"
			;;
		*.js|*.mjs|*.cjs) js_files+=("$f") ;;
		*.css)
			if under "$f" "${css_dirs[@]}"; then
				css_files+=("$f")
			else
				skipped+=("stylelint: $f")
			fi
			;;
		*.md)  md_files+=("$f") ;;
		*)
			# An extensionless file may be a Node program (scripts/ holds
			# several): eslint lints it if its config names it, and passes over
			# it otherwise, exactly as `make lint-js` does.
			case "$(basename "$f")" in
				*.*) unknown+=("$f") ;;
				*)   js_files+=("$f") ;;
			esac
			;;
	esac
done

if [ ${#missing[@]} -gt 0 ]; then
	echo "lint-files: these paths do not exist:" >&2
	printf '  %s\n' "${missing[@]}" >&2
	exit 2
fi

# go vet and golangci-lint see a package only if `go list $GO_PACKAGES` names
# it — the list lint-go hands them. That leaves out testdata dirs and the
# packages of other modules nested in the tree, as the whole-tree run does.
vet_dirs=()
if [ ${#go_dirs[@]} -gt 0 ]; then
	module="$(go list -m)"
	# shellcheck disable=SC2086
	linted="$(go list -e $GO_PACKAGES)"
	for d in "${go_dirs[@]}"; do
		if [ "$d" = . ]; then pkg="$module"; else pkg="$module/${d#./}"; fi
		if grep -qxF "$pkg" <<<"$linted"; then
			vet_dirs+=("$d")
		else
			skipped+=("go vet, golangci-lint: $d (not one of GO_PACKAGES)")
		fi
	done
fi

status=0

# Ensure a tooling/node_modules linter is present, installing the JS/CSS
# toolchain on demand the SAME way the Go path below bootstraps golangci-lint.
# A per-file lint that silently passes without ever running eslint/stylelint is
# worse than a clear failure — so if npm is unavailable we exit non-zero rather
# than skip (that silent skip is the bug this replaces). The linters live in
# exactly one place, tooling/node_modules, never duplicated elsewhere.
ensure_node_tooling() {
	local bin="$1"
	if [ -x "$NPM_BIN/$bin" ]; then return 0; fi
	if ! command -v npm &> /dev/null; then
		echo "lint-files: npm not found on PATH — cannot lint JS/CSS." >&2
		echo "Install Node.js (or run 'cd tooling && npm ci') and retry." >&2
		exit 2
	fi
	echo "Installing JS/CSS linters (cd tooling && npm ci)..."
	( cd tooling && npm ci --no-audit --no-fund --ignore-scripts ) || {
		echo "lint-files: 'npm ci' in tooling/ failed." >&2
		exit 2
	}
	if [ ! -x "$NPM_BIN/$bin" ]; then
		echo "lint-files: $bin still missing after 'npm ci'." >&2
		exit 2
	fi
}

ensure_golangci() {
	GOLANGCI_LINT_VERSION="$GOLANGCI_LINT_VERSION" scripts/ensure-golangci-lint
}

# ---- Go -------------------------------------------------------------------
if [ ${#go_files[@]} -gt 0 ]; then
	if [ -n "${FIX:-}" ]; then
		echo "==> gofmt -w (${#go_files[@]} file(s))"
		gofmt -w "${go_files[@]}"

		if [ ${#vet_dirs[@]} -gt 0 ]; then
			ensure_golangci
			echo "==> golangci-lint --fix (${#vet_dirs[@]} package(s))"
			"$GOPATH_BIN/golangci-lint" run --fix --timeout=5m "${vet_dirs[@]}" || status=1
		fi
	else
		echo "==> gofmt (${#go_files[@]} file(s))"
		unformatted="$(gofmt -l "${go_files[@]}")"
		if [ -n "$unformatted" ]; then
			echo "gofmt: the following files are not formatted:"
			echo "$unformatted"
			echo "fix with: make fix-files FILES=<file>   (or 'make fix-fmt' for the whole tree)"
			status=1
		fi

		if [ ${#vet_dirs[@]} -gt 0 ]; then
			echo "==> go vet (${#vet_dirs[@]} package(s))"
			go vet "${vet_dirs[@]}" || status=1

			ensure_golangci
			echo "==> golangci-lint (${#vet_dirs[@]} package(s))"
			"$GOPATH_BIN/golangci-lint" run --timeout=5m "${vet_dirs[@]}" || status=1
		fi
	fi
fi

# ---- JavaScript -----------------------------------------------------------
if [ ${#js_files[@]} -gt 0 ]; then
	ensure_node_tooling eslint
	if [ -n "${FIX:-}" ]; then
		echo "==> eslint --fix (${#js_files[@]} file(s))"
		NODE_NO_WARNINGS=1 "$NPM_BIN/eslint" --config tooling/eslint.config.js \
			--fix --no-warn-ignored "${js_files[@]}" || status=1
		ensure_node_tooling stylelint
		echo "==> lint-css-in-js --fix (${#js_files[@]} file(s))"
		NODE_NO_WARNINGS=1 node tooling/lint-css-in-js.js --fix "${js_files[@]}" || status=1
	else
		echo "==> eslint (${#js_files[@]} file(s))"
		# --no-warn-ignored: naming a file the config ignores or does not name
		# is a warning, and --max-warnings 0 turns that into a failure — so
		# without it any change that touches web/js/vendor, or an extensionless
		# file that is not JS, fails the lint it is exempt from.
		NODE_NO_WARNINGS=1 "$NPM_BIN/eslint" --config tooling/eslint.config.js \
			--max-warnings 0 --no-warn-ignored "${js_files[@]}" || status=1
		# The CSS they pass to injectStylesOnce(), under the stylelint config
		# the sheets use. The script narrows the list to its own scope, as the
		# whole-tree run in lint-css does.
		ensure_node_tooling stylelint
		echo "==> lint-css-in-js (${#js_files[@]} file(s))"
		NODE_NO_WARNINGS=1 node tooling/lint-css-in-js.js "${js_files[@]}" || status=1
		# The message catalogue is extracted from every t() in the tree, so it
		# is checked in full whenever any JavaScript changed.
		echo "==> i18n check"
		node scripts/i18n check || status=1
	fi
fi

# ---- CSS ------------------------------------------------------------------
if [ ${#css_files[@]} -gt 0 ]; then
	ensure_node_tooling stylelint
	if [ -n "${FIX:-}" ]; then
		echo "==> stylelint --fix (${#css_files[@]} file(s))"
		NODE_NO_WARNINGS=1 "$NPM_BIN/stylelint" --config tooling/.stylelintrc.json --fix "${css_files[@]}" || status=1
	else
		echo "==> stylelint (${#css_files[@]} file(s))"
		NODE_NO_WARNINGS=1 "$NPM_BIN/stylelint" --config tooling/.stylelintrc.json "${css_files[@]}" || status=1
	fi
	# Ownership, dead selectors and token parity are properties of the whole
	# stylesheet set, so this one runs in full however few files were named.
	if [ -z "${FIX:-}" ]; then
		echo "==> lint-css-arch"
		node scripts/lint-css-arch || status=1
	fi
fi

# ---- Markdown -------------------------------------------------------------
if [ ${#md_files[@]} -gt 0 ] && [ -z "${FIX:-}" ]; then
	# The symbol table this check works from is per document, not per block, so
	# it runs over the whole tree however few files were named — the same reason
	# lint-css-arch does.
	ensure_node_tooling eslint
	echo "==> lint-docs-code"
	node scripts/lint-docs-code || status=1
fi

# ---- Unroutable files -----------------------------------------------------
if [ ${#unknown[@]} -gt 0 ]; then
	echo "lint-files: no linter for these (skipped):" >&2
	printf '  %s\n' "${unknown[@]}" >&2
fi
if [ ${#skipped[@]} -gt 0 ]; then
	echo "lint-files: outside these linters' scope in the Makefile, as in 'make lint' (skipped):" >&2
	printf '  %s\n' "${skipped[@]}" >&2
fi

if [ "$status" -eq 0 ]; then
	if [ -n "${FIX:-}" ]; then
		echo "✓ fix-files applied — now run 'make lint-files' on the same paths"
	else
		echo "✓ lint-files passed"
	fi
fi
exit "$status"
