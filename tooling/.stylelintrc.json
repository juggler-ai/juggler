{
  "extends": "stylelint-config-standard",
  "plugins": ["stylelint-rem-over-px", "./stylelint-rules/no-literal-colour-function.js"],
  "rules": {
    "rem-over-px/rem-over-px": [
      true,
      {
        "ignore": ["1px"],
        "fontSize": 16,
        "ignoreFunctions": ["url"],
        "ignoreAtRules": [],
        "ignoreProperties": []
      }
    ],
    "unit-disallowed-list": [
      ["px"],
      {
        "ignoreProperties": {
          "px": ["/^border/", "outline", "box-shadow"]
        }
      }
    ],
    "color-no-hex": [true, { "reportDisables": true }],
    "color-named": ["never", { "reportDisables": true }],
    "juggler/no-literal-colour-function": [true, { "reportDisables": true }],
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "keyframes-name-pattern": null,
    "no-descending-specificity": null,
    "property-no-vendor-prefix": [true, { "ignoreProperties": ["-webkit-user-select"] }]
  },
  "overrides": [
    {
      "files": ["../web/css/tokens/*.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "juggler/no-literal-colour-function": null
      }
    }
  ]
}
