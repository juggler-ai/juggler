{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "/js/*": ["../web/js/*"],
      "/extensions/*": ["../web/extensions/*"],
      "yjs": ["./node_modules/yjs"],
      "juggler/context-item": ["../web/sdk/context-item.js"],
      "juggler/strategy-type": ["../web/sdk/strategy-type.js"],
      "juggler/command-type": ["../web/sdk/command-type.js"],
      "juggler/info-card-type": ["../web/sdk/info-card-type.js"],
      "juggler/pinboard": ["../web/sdk/pinboard.js"],
      "juggler/pinboard-item-type": ["../web/sdk/pinboard-item-type.js"],
      "juggler/file-viewer": ["../web/sdk/file-viewer.js"],
      "juggler/workspace-provider": ["../web/sdk/workspace-provider.js"],
      "juggler/hook-type": ["../web/sdk/hook-type.js"],
      "juggler/file-source": ["../web/sdk/file-source.js"],
      "juggler/ops": ["../web/sdk/ops.js"],
      "juggler/sandbox": ["../web/sdk/sandbox.js"],
      "juggler/ui": ["../web/sdk/ui.js"],
      "juggler/model": ["../web/sdk/model.js"],
      "juggler/item-utils": ["../web/sdk/item-utils.js"],
      "juggler/registry": ["../web/sdk/registry.js"],
      "juggler/version": ["../web/sdk/version.js"],
      "juggler/i18n": ["../web/sdk/i18n.js"],
      "juggler/utils/html": ["../web/sdk/lib/html.js"],
      "juggler/utils/path-containment": ["../web/sdk/lib/path-containment.js"],
      "juggler/utils/debounce": ["../web/sdk/lib/debounce.js"]
    }
  },
  "include": [
    "../web/js/**/*.js",
    "../web/js/types/**/*.d.ts",
    "../web/sdk/**/*.js",
    "../web/extensions/**/*.js",
    "../web/machine/**/*.js",
    "../examples/**/*.js",
    "../web/js-tests/**/*.js"
  ],
  "exclude": [
    "../web/js/vendor/**",
    "node_modules"
  ]
}
