	"$enumerates": "A sheet whose job is to state ONE policy across every surface it applies to, rather than to own a group of its own: base/text-selection.css (what a mouse drag may select) and patterns/popup-surface.css (the outer card every transient surface wears). Their selectors name roots other sheets own, and that is the point — the alternative is the same declaration copied into a dozen component files, where nobody can see it is one decision. The ownership check skips them. They earn it by being small, by holding one policy each, and by sitting in the lowest layer that can state it, so any component can still override its own case.",
	"$dynamicClasses": "Class names assembled in JS, so no literal exists to find. Each pattern below was proven by locating the composing expression (e.g. `color-${…}`) in web/js or web/sdk. Keep them tight: a pattern broad enough to cover a whole family stops the dead-selector check from seeing anything in it.",
	"dynamicClasses": [
		"color-*",
		"status-*",
		"origin-*",
		"ext-source-*",
		"ext-cap-type-*",
		"tool-category-*",
		"tx-tool-category-*",
		"plugin-tree-toggle-*",
		"slash-command-scope-*",
		"approval-source-*",
		"pp-status--*",
		"task-box--*",
		"bash-command-segment-*"
	],
	"$jsSetProperties": "Custom properties set from JS rather than declared in CSS, so a bare var() referring to one is not a dangling reference.",
	"jsSetProperties": [
		"--strategy-color",
		"--logo-with-name-url",
		"--workspace-tint",
		"--dropdown-x",
		"--dropdown-y",
		"--popup-origin",
		"--pinboard-width",
		"--update-pct",
		"--scrim-from",
		"--js-angle",
		"--js-phase",
		"--line-digits",
		"--tt-arrow-x"
	]
}
