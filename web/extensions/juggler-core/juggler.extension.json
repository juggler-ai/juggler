{
  "id": "@juggler/core",
  "name": "Juggler Core",
  "version": "1.0.0",
  "author": "Juggler Team",
  "homepage": "https://juggler.studio",
  "license": "Apache-2.0",
  "engineApi": "^1.3.0",
  "permissions": [
    "filesystem.read",
    "filesystem.write",
    "shell.exec",
    "web.fetch"
  ],
  "settings": [
    {
      "key": "reviewLevel",
      "type": "enum",
      "label": "Auto-approve review level",
      "help": "How strict the Auto-approve reviewer is. balanced: approves only what your messages or standing permissions cover. relaxed: also trusts routine in-project work the agent chose itself. custom: applies the policy below.",
      "options": ["balanced", "relaxed", "custom"],
      "default": "balanced",
      "capability": "strategy:auto-approve"
    },
    {
      "key": "customPolicy",
      "type": "text",
      "label": "Auto-approve custom policy",
      "help": "Shows the selected level's policy; choose custom to edit it. The reviewer always sees only your messages and the agent's tool calls, and always answers allow or deny.",
      "capability": "strategy:auto-approve"
    }
  ],
  "provides": {
    "i18n": "i18n",
    "contextItems": ["context-items/*-context-item.js"],
    "strategies": ["strategies/*-strategy-type.js"],
    "commands": ["commands/*-command-type.js"],
    "infoCards": ["cards/*-card.js"],
    "pinboardItems": ["pins/*-pin.js"],
    "pinboardItemMeta": ["pins/*-pin.meta.js"],
    "fileViewers": ["viewers/*-file-viewer.js"],
    "workspaceProviders": ["workspaces/*-workspace-provider.js"],
    "searchBackends": ["search-backends/*-backend.js"],
    "systemPrompt": "system-prompt-contribution.js",
    "tests": ["_tests/*-test.js"],
    "integrationTests": ["_tests/integration/*-tests.js"]
  }
}
